@page "/cars"
@using FuelTracker.Models
@using FuelTracker.Services
@inject StorageService Storage
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Mina bilar</PageTitle>

<div class="fuel-cars-page">

    @if (!isInitialLoading)
    {

        <!-- Header -->
        <header class="fuel-page-header">

            <div class="fuel-page-header-icon fuel-cars-header-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m5 11 1.5-4h11L19 11" />
                    <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                    <circle cx="7" cy="16" r="1" />
                    <circle cx="17" cy="16" r="1" />
                </svg>
            </div>

            <div>
                <div class="fuel-eyebrow">
                    GARAGE
                </div>

                <h1>Mina bilar</h1>

                <p>
                    Hantera dina fordon.
                </p>
            </div>

        </header>


        <!-- LÄGG TILL BIL -->
        <section class="fuel-car-form">

            <div class="fuel-car-form-heading">

                <div>
                    <div class="fuel-eyebrow">
                        NYTT FORDON
                    </div>

                    <h2>Lägg till bil</h2>
                </div>

                <div class="fuel-car-form-plus">
                    +
                </div>

            </div>


            <!-- Bilens namn -->
            <div class="fuel-car-field">

                <label>

                    <span class="fuel-car-field-icon fuel-car-purple">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m5 11 1.5-4h11L19 11" />
                            <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                            <circle cx="7" cy="16" r="1" />
                            <circle cx="17" cy="16" r="1" />
                        </svg>
                    </span>

                    <span>
                        Bilens namn
                        <small>T.ex. Volvo V70</small>
                    </span>

                </label>

                <div class="fuel-car-input-wrapper">

                    <input class="fuel-car-input"
                    @bind="carName"
                    placeholder="Volvo V70" />

                </div>

            </div>


            <!-- Registreringsnummer -->
            <div class="fuel-car-field">

                <label>

                    <span class="fuel-car-field-icon fuel-car-cyan">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="6" width="18" height="12" rx="2" />
                            <path d="M7 10h10" />
                            <path d="M7 14h6" />
                        </svg>
                    </span>

                    <span>
                        Registreringsnummer
                        <small>T.ex. ABC123</small>
                    </span>

                </label>

                <div class="fuel-car-input-wrapper">

                    <input class="fuel-car-input fuel-registration-input"
                    @bind="registrationNumber"
                    placeholder="ABC123"
                    maxlength="10" />

                </div>

            </div>


            <!-- Bränsle -->
            <div class="fuel-car-field fuel-car-field-last">

                <label>

                    <span class="fuel-car-field-icon fuel-car-orange">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 3h9v18H4V5a2 2 0 0 1 2-2Z" />
                            <path d="M7 6h5v5H7z" />
                            <path d="M15 8h2l3 3v6a2 2 0 0 1-4 0" />
                        </svg>
                    </span>

                    <span>
                        Bränsletyp
                        <small>Vad kör bilen på?</small>
                    </span>

                </label>

                <div class="fuel-custom-select">

                    <button type="button"
                    class="fuel-car-input fuel-custom-select-button"
                    @onclick="ToggleFuelTypeDropdown">

                        <span>@FuelTypeDisplayName</span>

                        <span class="fuel-custom-select-arrow @(fuelTypeDropdownOpen ? "open" : "")">
                            ⌄
                        </span>

                    </button>

                    @if (fuelTypeDropdownOpen)
                    {
                        <div class="fuel-custom-select-menu">

                            <button type="button"
                            class="fuel-custom-select-option"
                            @onclick='() => SelectFuelType("")'>
                                Välj bränsletyp
                            </button>

                            <button type="button"
                            class="fuel-custom-select-option @(fuelType == "Bensin" ? "selected" : "")"
                            @onclick='() => SelectFuelType("Bensin")'>
                                Bensin
                            </button>

                            <button type="button"
                            class="fuel-custom-select-option @(fuelType == "Diesel" ? "selected" : "")"
                            @onclick='() => SelectFuelType("Diesel")'>
                                Diesel
                            </button>

                            <button type="button"
                            class="fuel-custom-select-option @(fuelType == "E85" ? "selected" : "")"
                            @onclick='() => SelectFuelType("E85")'>
                                E85
                            </button>

                            <button type="button"
                            class="fuel-custom-select-option @(fuelType == "EL" ? "selected" : "")"
                            @onclick='() => SelectFuelType("EL")'>
                                EL
                            </button>

                            <button type="button"
                            class="fuel-custom-select-option @(fuelType == "Hybrid" ? "selected" : "")"
                            @onclick='() => SelectFuelType("Hybrid")'>
                                Hybrid
                            </button>

                        </div>
                    }

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="fuel-car-error">
                    @errorMessage
                </div>
            }


            <button class="fuel-add-car-button"
            @onclick="AddCar">

                <span class="fuel-add-car-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m5 11 1.5-4h11L19 11" />
                        <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                        <circle cx="7" cy="16" r="1" />
                        <circle cx="17" cy="16" r="1" />
                    </svg>
                </span>

                <span>
                    Lägg till bil
                </span>

                <span class="fuel-add-car-plus">
                    +
                </span>

            </button>

        </section>


        <!-- DINA BILAR -->
        <section class="fuel-car-list">

            <div class="fuel-car-list-heading">

                <div>
                    <div class="fuel-eyebrow">
                        DITT GARAGE
                    </div>

                    <h2>Dina bilar</h2>
                </div>

                <span class="fuel-car-count">
                    @cars.Count
                </span>

            </div>


            @if (cars.Count == 0)
            {
                <div class="fuel-cars-empty">

                    <div class="fuel-cars-empty-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m5 11 1.5-4h11L19 11" />
                            <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                            <circle cx="7" cy="16" r="1" />
                            <circle cx="17" cy="16" r="1" />
                        </svg>
                    </div>

                    <h3>Garaget är tomt</h3>

                    <p>
                        Lägg till din första bil ovan.
                    </p>

                </div>
            }
            else
            {
                @foreach (var car in cars)
                {
                    <article class="fuel-car-card">

                        <div class="fuel-car-card-accent"></div>

                        <div class="fuel-car-card-top">

                            <div class="fuel-car-card-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m5 11 1.5-4h11L19 11" />
                                    <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                                    <circle cx="7" cy="16" r="1" />
                                    <circle cx="17" cy="16" r="1" />
                                </svg>
                            </div>

                            <div class="fuel-car-card-name">

                                <span>FORDON</span>

                                <h3>
                                    @car.Name
                                </h3>

                            </div>

                        </div>


                        <div class="fuel-car-info">

                            <div class="fuel-car-info-item">

                                <span>REGISTRERING</span>

                                <strong class="fuel-registration-badge">
                                    @(
                                                            string.IsNullOrWhiteSpace(car.RegistrationNumber)
                                                                                                ? "SAKNAS"
                                                                                                : car.RegistrationNumber
                                                )
                                            </strong>

                                        </div>


                                        <div class="fuel-car-info-divider"></div>


                                        <div class="fuel-car-info-item">

                                            <span>BRÄNSLE</span>

                                            <strong class="fuel-type-badge">
                                                <i></i>
                                                @car.FuelType
                                            </strong>

                                        </div>

                                    </div>


                                    @if (carToDelete == car.Id)
                        {
                            <div class="fuel-car-delete-confirm">

                                <div class="fuel-car-delete-warning">

                                    <div class="fuel-car-delete-warning-icon">
                                        !
                                    </div>

                                    <div>
                                        <strong>
                                            Ta bort @car.Name?
                                        </strong>

                                        <p>
                                            Bilen tas bort från Mina bilar.
                                            Dina tidigare tankningar sparas.
                                        </p>
                                    </div>

                                </div>

                                <div class="fuel-car-delete-actions">

                                    <button class="fuel-car-danger-button"
                                    @onclick="() => DeleteCar(car)">
                                        Ja, ta bort
                                    </button>

                                    <button class="fuel-car-cancel-button"
                                    @onclick="CancelDelete">
                                        Avbryt
                                    </button>

                                </div>

                            </div>
                        }
                        else
                        {
                            <button class="fuel-car-delete-button"
                            @onclick="() => AskToDelete(car)">

                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M4 7h16" />
                                    <path d="m9 7 1-3h4l1 3" />
                                    <path d="M7 7l1 13h8l1-13" />
                                </svg>

                                Ta bort bil

                            </button>
                        }

                    </article>
                }
            }

        </section>
    }
</div>

<SuccessToast @ref="successToast"
              Message="Bilen är sparad!"
              Description="Bilen har lagts till i din lista." />

<SuccessToast @ref="errorToast"
              Message="Kunde inte ta bort bilen"
              Description="@deleteErrorMessage"
              Variant="danger" />

<SuccessToast @ref="deleteSuccessToast"
              Message="Bilen är borttagen"
              Description="Bilen har tagits bort från gruppen."
              Variant="danger" />

@code {

    private List<Car> cars = new();

    private bool isInitialLoading = true;

    private string carName = "";
    private string registrationNumber = "";
    private string fuelType = "";
    private SuccessToast? successToast;
    private SuccessToast? errorToast;
    private SuccessToast? deleteSuccessToast;
    private string errorMessage = "";
    private string deleteErrorMessage = "";
    private string? groupToken;

    private Guid? carToDelete;


    private bool fuelTypeDropdownOpen = false;

private string FuelTypeDisplayName =>
    string.IsNullOrWhiteSpace(fuelType)
        ? "Välj bränsletyp"
        : fuelType;

private void ToggleFuelTypeDropdown()
{
    fuelTypeDropdownOpen = !fuelTypeDropdownOpen;
}

private void SelectFuelType(string type)
{
    fuelType = type;
    fuelTypeDropdownOpen = false;
}
    
    
    protected override async Task OnInitializedAsync()
    {
        groupToken =
            await Storage.LoadAsync<string>("groupToken");

        if (string.IsNullOrWhiteSpace(groupToken))
        {
            cars =
                await Storage.LoadAsync<List<Car>>("cars")
                ?? new List<Car>();

            isInitialLoading = false;
            return;
        }

        try
        {
            using var request =
                new HttpRequestMessage(
                    HttpMethod.Get,
                    "api/cars");

            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    groupToken);

            var response =
                await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result =
                    await response.Content.ReadFromJsonAsync<CarsResponse>();

                cars =
                    result?.Cars
                    ?? new List<Car>();
            }
            else
            {
                errorMessage =
                    "Kunde inte hämta gruppens bilar.";
            }
        }
        catch
        {
            errorMessage =
                "Kunde inte ansluta till servern.";
        }
        isInitialLoading = false;
    }


    private async Task AddCar()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(carName))
        {
            errorMessage = "Ange ett namn på bilen.";
            return;
        }

        if (string.IsNullOrWhiteSpace(fuelType))
        {
            errorMessage = "Välj vilken bränsletyp bilen använder.";
            return;
        }

        var car = new Car
        {
            Name = carName.Trim(),

            RegistrationNumber =
                registrationNumber
                    .Trim()
                    .ToUpper(),

            FuelType = fuelType
        };

        if (string.IsNullOrWhiteSpace(groupToken))
        {
            cars.Add(car);

            await Storage.SaveAsync(
                "cars",
                cars);
        }
        else
        {
            using var request =
                new HttpRequestMessage(
                    HttpMethod.Post,
                    "api/cars");

            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    groupToken);

            request.Content =
                JsonContent.Create(new
                {
                    name = car.Name,
                    registrationNumber = car.RegistrationNumber,
                    fuelType = car.FuelType
                });

            var response =
                await Http.SendAsync(request);

            if (!response.IsSuccessStatusCode)
            {
                var errorResult =
                    await response.Content.ReadFromJsonAsync<ErrorResponse>();

                deleteErrorMessage =
                    errorResult?.Error
                    ?? "Kunde inte ta bort bilen från gruppen.";

                carToDelete = null;

                if (errorToast != null)
                {
                    _ = errorToast.ShowAsync();
                }

                return;
            }

            var result =
    await response.Content.ReadFromJsonAsync<CarResponse>();

            if (result?.Car != null)
            {
                cars.Add(result.Car);
            }
        }

        carName = "";
        registrationNumber = "";
        fuelType = "";

        carToDelete = null;

        if (successToast != null)
        {
            _ = successToast.ShowAsync();
        }
    }


    private void AskToDelete(Car car)
    {
        carToDelete = car.Id;
    }


    private void CancelDelete()
    {
        carToDelete = null;
    }


    private async Task DeleteCar(Car car)
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(groupToken))
        {
            cars.RemoveAll(c => c.Id == car.Id);

            await Storage.SaveAsync(
                "cars",
                cars);

            carToDelete = null;

            if (deleteSuccessToast != null)
            {
                _ = deleteSuccessToast.ShowAsync();
            }

            return;
        }

        try
        {
            using var request =
                new HttpRequestMessage(
                    HttpMethod.Delete,
                    $"api/cars?id={car.Id}");

            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    groupToken);

            var response =
                await Http.SendAsync(request);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    "Kunde inte ta bort bilen från gruppen.";

                return;
            }

            cars.RemoveAll(c => c.Id == car.Id);

            carToDelete = null;
            if (deleteSuccessToast != null)
            {
                _ = deleteSuccessToast.ShowAsync();
            }
        }
        catch
        {
            deleteErrorMessage =
                "Kunde inte ansluta till servern.";

            carToDelete = null;

            if (errorToast != null)
            {
                _ = errorToast.ShowAsync();
            }
        }
    }

    private class CarsResponse
    {
        public bool Success { get; set; }

        public List<Car> Cars { get; set; } = new();
    }

    private class CarResponse
    {
        public bool Success { get; set; }

        public Car? Car { get; set; }
    }

    private class ErrorResponse
    {
        public string Error { get; set; } = "";
    }
}