@page "/cars"
@using FuelTracker.Models
@using FuelTracker.Services
@inject StorageService Storage

<PageTitle>Mina bilar</PageTitle>

<div class="fuel-cars-page">

    <BackButton />

    <!-- Header -->
    <header class="fuel-page-header">

        <div class="fuel-page-header-icon fuel-cars-header-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m5 11 1.5-4h11L19 11" />
                <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                <circle cx="7" cy="16" r="1" />
                <circle cx="17" cy="16" r="1" />
            </svg>
        </div>

        <div>
            <div class="fuel-eyebrow">
                GARAGE
            </div>

            <h1>Mina bilar</h1>

            <p>
                Hantera dina fordon.
            </p>
        </div>

    </header>


    <!-- LÄGG TILL BIL -->
    <section class="fuel-car-form">

        <div class="fuel-car-form-heading">

            <div>
                <div class="fuel-eyebrow">
                    NYTT FORDON
                </div>

                <h2>Lägg till bil</h2>
            </div>

            <div class="fuel-car-form-plus">
                +
            </div>

        </div>


        <!-- Bilens namn -->
        <div class="fuel-car-field">

            <label>

                <span class="fuel-car-field-icon fuel-car-purple">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m5 11 1.5-4h11L19 11" />
                        <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                        <circle cx="7" cy="16" r="1" />
                        <circle cx="17" cy="16" r="1" />
                    </svg>
                </span>

                <span>
                    Bilens namn
                    <small>T.ex. Volvo V70</small>
                </span>

            </label>

            <div class="fuel-car-input-wrapper">

                <input class="fuel-car-input"
                       @bind="carName"
                       placeholder="Volvo V70" />

            </div>

        </div>


        <!-- Registreringsnummer -->
        <div class="fuel-car-field">

            <label>

                <span class="fuel-car-field-icon fuel-car-cyan">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="6" width="18" height="12" rx="2" />
                        <path d="M7 10h10" />
                        <path d="M7 14h6" />
                    </svg>
                </span>

                <span>
                    Registreringsnummer
                    <small>T.ex. ABC123</small>
                </span>

            </label>

            <div class="fuel-car-input-wrapper">

                <input class="fuel-car-input fuel-registration-input"
                       @bind="registrationNumber"
                       placeholder="ABC123"
                       maxlength="10" />

            </div>

        </div>


        <!-- Bränsle -->
        <div class="fuel-car-field fuel-car-field-last">

            <label>

                <span class="fuel-car-field-icon fuel-car-orange">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 3h9v18H4V5a2 2 0 0 1 2-2Z" />
                        <path d="M7 6h5v5H7z" />
                        <path d="M15 8h2l3 3v6a2 2 0 0 1-4 0" />
                    </svg>
                </span>

                <span>
                    Bränsletyp
                    <small>Vad kör bilen på?</small>
                </span>

            </label>

            <div class="fuel-car-input-wrapper">

                <select class="fuel-car-input"
                        @bind="fuelType">

                    <option value="">
                        Välj bränsletyp
                    </option>

                    <option value="Bensin">Bensin</option>
                    <option value="Diesel">Diesel</option>
                    <option value="E85">E85</option>
                    <option value="El">El</option>
                    <option value="Hybrid">Hybrid</option>

                </select>

            </div>

        </div>


        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="fuel-car-error">
                @errorMessage
            </div>
        }


        <button class="fuel-add-car-button"
                @onclick="AddCar">

            <span class="fuel-add-car-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m5 11 1.5-4h11L19 11" />
                    <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                    <circle cx="7" cy="16" r="1" />
                    <circle cx="17" cy="16" r="1" />
                </svg>
            </span>

            <span>
                Lägg till bil
            </span>

            <span class="fuel-add-car-plus">
                +
            </span>

        </button>

    </section>


    <!-- DINA BILAR -->
    <section class="fuel-car-list">

        <div class="fuel-car-list-heading">

            <div>
                <div class="fuel-eyebrow">
                    DITT GARAGE
                </div>

                <h2>Dina bilar</h2>
            </div>

            <span class="fuel-car-count">
                @cars.Count
            </span>

        </div>


        @if (cars.Count == 0)
        {
            <div class="fuel-cars-empty">

                <div class="fuel-cars-empty-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m5 11 1.5-4h11L19 11" />
                        <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                        <circle cx="7" cy="16" r="1" />
                        <circle cx="17" cy="16" r="1" />
                    </svg>
                </div>

                <h3>Garaget är tomt</h3>

                <p>
                    Lägg till din första bil ovan.
                </p>

            </div>
        }
        else
        {
            @foreach (var car in cars)
            {
                <article class="fuel-car-card">

                    <div class="fuel-car-card-accent"></div>

                    <div class="fuel-car-card-top">

                        <div class="fuel-car-card-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m5 11 1.5-4h11L19 11" />
                                <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                                <circle cx="7" cy="16" r="1" />
                                <circle cx="17" cy="16" r="1" />
                            </svg>
                        </div>

                        <div class="fuel-car-card-name">

                            <span>FORDON</span>

                            <h3>
                                @car.Name
                            </h3>

                        </div>

                    </div>


                    <div class="fuel-car-info">

                        <div class="fuel-car-info-item">

                            <span>REGISTRERING</span>

                            <strong class="fuel-registration-badge">
                                @(string.IsNullOrWhiteSpace(car.RegistrationNumber)
                                    ? "SAKNAS"
                                    : car.RegistrationNumber)
                            </strong>

                        </div>


                        <div class="fuel-car-info-divider"></div>


                        <div class="fuel-car-info-item">

                            <span>BRÄNSLE</span>

                            <strong class="fuel-type-badge">
                                <i></i>
                                @car.FuelType
                            </strong>

                        </div>

                    </div>


                    @if (carToDelete == car.Id)
                    {
                        <div class="fuel-car-delete-confirm">

                            <div class="fuel-car-delete-warning">

                                <div class="fuel-car-delete-warning-icon">
                                    !
                                </div>

                                <div>
                                    <strong>
                                        Ta bort @car.Name?
                                    </strong>

                                    <p>
                                        Bilen tas bort från Mina bilar.
                                        Dina tidigare tankningar sparas.
                                    </p>
                                </div>

                            </div>

                            <div class="fuel-car-delete-actions">

                                <button class="fuel-car-danger-button"
                                        @onclick="() => DeleteCar(car)">
                                    Ja, ta bort
                                </button>

                                <button class="fuel-car-cancel-button"
                                        @onclick="CancelDelete">
                                    Avbryt
                                </button>

                            </div>

                        </div>
                    }
                    else
                    {
                        <button class="fuel-car-delete-button"
                                @onclick="() => AskToDelete(car)">

                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 7h16" />
                                <path d="m9 7 1-3h4l1 3" />
                                <path d="M7 7l1 13h8l1-13" />
                            </svg>

                            Ta bort bil

                        </button>
                    }

                </article>
            }
        }

    </section>

</div>


@code {

    private List<Car> cars = new();

    private string carName = "";
    private string registrationNumber = "";
    private string fuelType = "";

    private string errorMessage = "";

    private Guid? carToDelete;


    protected override async Task OnInitializedAsync()
    {
        cars =
            await Storage.LoadAsync<List<Car>>("cars")
            ?? new List<Car>();
    }


    private async Task AddCar()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(carName))
        {
            errorMessage = "Ange ett namn på bilen.";
            return;
        }

        if (string.IsNullOrWhiteSpace(fuelType))
        {
            errorMessage = "Välj vilken bränsletyp bilen använder.";
            return;
        }

        var car = new Car
        {
            Name = carName.Trim(),

            RegistrationNumber =
                registrationNumber
                    .Trim()
                    .ToUpper(),

            FuelType = fuelType
        };

        cars.Add(car);

        await Storage.SaveAsync(
            "cars",
            cars);

        carName = "";
        registrationNumber = "";
        fuelType = "";

        carToDelete = null;
    }


    private void AskToDelete(Car car)
    {
        carToDelete = car.Id;
    }


    private void CancelDelete()
    {
        carToDelete = null;
    }


    private async Task DeleteCar(Car car)
    {
        cars.RemoveAll(
            c => c.Id == car.Id);

        await Storage.SaveAsync(
            "cars",
            cars);

        carToDelete = null;
    }
}