@page "/"
@using FuelTracker.Models
@using FuelTracker.Services
@using System.Globalization
@inject StorageService Storage
@inject NavigationManager Navigation
@inject HttpClient Http
@inject FuelDataService FuelData

<PageTitle>FuelTracker</PageTitle>

<div class="home-page fuel-home">

    @if (!isInitialLoading)
    {

        <!-- Header -->
        <!-- Header -->
        <header class="fuel-header fuel-animate fuel-delay-1">

            <div>
                <div class="fuel-brand">

                    <div class="fuel-brand-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 2h8a2 2 0 0 1 2 2v16H4V4a2 2 0 0 1 2-2Z" />
                            <path d="M7 5h6v5H7z" />
                            <path d="M16 7h2l2 3v7a2 2 0 0 1-4 0" />
                            <path d="M8 15h4" />
                        </svg>
                    </div>

                    <div>
                        <h1 class="fuel-logo mb-0">
                            Fuel<span>Tracker</span>
                        </h1>

                        <p class="fuel-subtitle mb-0">
                            Koll på dina tankningar
                        </p>
                    </div>

                </div>
            </div>

            <!-- Grupp -->
            <button class="fuel-group-header-button"
            @onclick="GoToGroup"
            aria-label="Grupp">

                <span class="fuel-group-header-icon">👥</span>
                <span>@(isInGroup ? "Min grupp" : "Grupp")</span>

            </button>
            <!-- Inställningar -->
            <div class="fuel-settings-wrapper">

                <button class="fuel-settings-button"
                @onclick="ToggleSettings"
                aria-label="Inställningar">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6v-.2h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z" />
                    </svg>

                </button>


                @if (showSettings)
                {
                    <div class="fuel-settings-menu">

                        <div class="fuel-settings-menu-header">
                            INSTÄLLNINGAR
                        </div>

                        <button class="fuel-settings-menu-item"
                        @onclick="GoToBackup">

                            <span class="fuel-settings-menu-icon">

                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M5 5a2 2 0 0 1 2-2h8l4 4v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2Z" />
                                    <path d="M8 3v6h7V3" />
                                    <path d="M9 17h6" />
                                </svg>

                            </span>

                            <span class="fuel-settings-menu-text">
                                <strong>Backup & återställ</strong>
                                <small>Spara eller återställ din data</small>
                            </span>

                            <svg class="fuel-settings-menu-arrow"
                            viewBox="0 0 24 24"
                            aria-hidden="true">
                                <path d="m9 18 6-6-6-6" />
                            </svg>

                        </button>

                    </div>
                }

            </div>

        </header>

        <!-- Månad -->
        <section class="fuel-section fuel-animate fuel-delay-2">

            <div class="fuel-section-heading">

                <div>
                    <div class="fuel-eyebrow">
                        DEN HÄR MÅNADEN
                    </div>

                    <h2>
                        @CurrentMonthName
                    </h2>
                </div>

                <button class="fuel-history-link"
                @onclick="GoToHistory">
                    Historik

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m9 18 6-6-6-6" />
                    </svg>
                </button>

            </div>

            <!-- Statistik -->
            <div class="fuel-stats-grid">

                <div class="fuel-stat-card fuel-stat-purple">

                    <div class="fuel-stat-top">
                        <div class="fuel-stat-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M6 3h9v18H4V5a2 2 0 0 1 2-2Z" />
                                <path d="M7 6h5v5H7z" />
                                <path d="M15 8h2l3 3v6a2 2 0 0 1-4 0" />
                            </svg>
                        </div>

                        <span>Tankningar</span>
                    </div>

                    <div class="fuel-stat-number">
                        @CurrentMonthEntries.Count
                    </div>

                    <div class="fuel-stat-glow"></div>

                </div>

                <div class="fuel-stat-card fuel-stat-cyan">

                    <div class="fuel-stat-top">
                        <div class="fuel-stat-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M15.5 8.5c-.8-.7-1.8-1-3-1-1.7 0-3 .8-3 2s1 1.8 3 2.2 3 1 3 2.3-1.3 2.2-3.2 2.2c-1.2 0-2.4-.4-3.3-1.2" />
                                <path d="M12 5.5v13" />
                            </svg>
                        </div>

                        <span>Spenderat</span>
                    </div>

                    <div class="fuel-stat-number fuel-money">
                        @MonthlyCost.ToString("0.00")
                        <small>kr</small>
                    </div>

                    <div class="fuel-stat-glow"></div>

                </div>

            </div>

        </section>

        <!-- Ny tankning -->
        <section class="fuel-animate fuel-delay-3">

            <button class="fuel-main-action"
            @onclick="GoToAddFuel">

                <span class="fuel-main-action-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 3h9v18H4V5a2 2 0 0 1 2-2Z" />
                        <path d="M7 6h5v5H7z" />
                        <path d="M15 8h2l3 3v6a2 2 0 0 1-4 0" />
                    </svg>
                </span>

                <span class="fuel-main-action-text">
                    <strong>Ny tankning</strong>
                    <small>Registrera ditt senaste stopp</small>
                </span>

                <span class="fuel-main-action-plus">
                    +
                </span>

            </button>

        </section>

        <!-- Senaste tankningen -->
        <section class="fuel-section fuel-animate fuel-delay-4">

            <div class="fuel-section-heading fuel-latest-heading">

                <div>
                    <h2>
                        Senaste tankningen
                    </h2>
                </div>

            </div>



            @if (LatestEntry == null)
            {
                <div class="fuel-empty-card">

                    <div class="fuel-empty-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 3h9v18H4V5a2 2 0 0 1 2-2Z" />
                            <path d="M7 6h5v5H7z" />
                            <path d="M15 8h2l3 3v6a2 2 0 0 1-4 0" />
                        </svg>
                    </div>

                    <h3>Inga tankningar ännu</h3>

                    <p>
                        Din senaste tankning kommer att visas här.
                    </p>

                    <button class="fuel-small-action"
                    @onclick="GoToAddFuel">
                        Lägg till första tankningen
                    </button>

                </div>
            }
            else
            {
                var latestEntry = LatestEntry;

                var latestCar =
                    cars.FirstOrDefault(c => c.Id == latestEntry.CarId);

                var displayCarName =
                    !string.IsNullOrWhiteSpace(latestEntry.CarName)
                        ? latestEntry.CarName
                        : latestCar?.Name ?? "Okänd bil";

                <div class="fuel-latest-card">

                    <div class="fuel-latest-accent"></div>

                    <div class="fuel-latest-top">

                        <div class="fuel-car-info">

                            <div class="fuel-car-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m5 11 1.5-4h11L19 11" />
                                    <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                                    <circle cx="7" cy="16" r="1" />
                                    <circle cx="17" cy="16" r="1" />
                                </svg>
                            </div>

                            <div>
                                <h3>
                                    @displayCarName
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(latestEntry.MemberName))
                                {
                                    <span class="fuel-latest-member">
                                        Tankat av @latestEntry.MemberName
                                    </span>
                                }

                                <span>
                                    @latestEntry.Date.ToString(
                                                                                                "d MMMM yyyy",
                                                                                                SwedishCulture)
                                </span>
                            </div>

                        </div>

                        <div class="fuel-price-pill">
                            @latestEntry.PricePerLiter.ToString("0.00")
                            <small>kr/L</small>
                        </div>

                    </div>

                    <div class="fuel-latest-values">

                        <div>
                            <span>Liter</span>
                            <strong>
                                @latestEntry.Liters.ToString("0.##")
                                <small>L</small>
                            </strong>
                        </div>

                        <div class="fuel-value-divider"></div>

                        <div>
                            <span>Kostnad</span>
                            <strong>
                                @latestEntry.TotalCost.ToString("0.00")
                                <small>kr</small>
                            </strong>
                        </div>

                    </div>



                </div>
            }

        </section>

        <!-- Mina bilar -->
        <section class="fuel-animate fuel-delay-5">

            <button class="fuel-secondary-action"
            @onclick="GoToCars">

                <span class="fuel-secondary-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m5 11 1.5-4h11L19 11" />
                        <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                        <circle cx="7" cy="16" r="1" />
                        <circle cx="17" cy="16" r="1" />
                    </svg>
                </span>

                <span>
                    <strong>Mina bilar</strong>
                    <small>Hantera dina fordon</small>
                </span>

                <svg class="fuel-secondary-arrow"
                viewBox="0 0 24 24"
                aria-hidden="true">
                    <path d="m9 18 6-6-6-6" />
                </svg>

            </button>

        </section>
    }

</div>

@code {

    private List<Car> cars = new();
    private List<FuelEntry> fuelEntries = new();

    private bool isInitialLoading = true;

    private bool showSettings = false;
    private bool isInGroup = false;

    private CultureInfo SwedishCulture =>
        CultureInfo.GetCultureInfo("sv-SE");

    private List<FuelEntry> CurrentMonthEntries =>
        fuelEntries
            .Where(entry =>
                entry.Date.Year == DateTime.Today.Year &&
                entry.Date.Month == DateTime.Today.Month)
            .ToList();

    private decimal MonthlyCost =>
        CurrentMonthEntries.Sum(entry => entry.TotalCost);

    private FuelEntry? LatestEntry =>
        fuelEntries
            .OrderByDescending(entry => entry.Date)
            .ThenByDescending(entry => entry.Id)
            .FirstOrDefault();

    private string CurrentMonthName
    {
        get
        {
            var month =
                DateTime.Today.ToString(
                    "MMMM yyyy",
                    SwedishCulture);

            return char.ToUpper(month[0]) + month[1..];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var groupToken =
            await Storage.LoadAsync<string>("groupToken");

        isInGroup =
            !string.IsNullOrWhiteSpace(groupToken);

        // Ingen grupp = använd lokal data som tidigare.
        if (!isInGroup)
        {
            cars =
                await Storage.LoadAsync<List<Car>>("cars")
                ?? new List<Car>();

            fuelEntries =
                await Storage.LoadAsync<List<FuelEntry>>("fuelEntries")
                ?? new List<FuelEntry>();

            isInitialLoading = false;
            return;
        }

        // Gruppdata finns redan i minnet.
        // Då behövs inga nya GET-anrop när vi går tillbaka till Home.
        if (FuelData.IsLoaded)
        {
            cars = FuelData.Cars;
            fuelEntries = FuelData.FuelEntries;

            isInitialLoading = false;
            return;
        }

        try
        {
            using var carsRequest =
                new HttpRequestMessage(
                    HttpMethod.Get,
                    "api/cars");

            carsRequest.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    groupToken);

            var carsResponse =
                await Http.SendAsync(carsRequest);

            if (carsResponse.IsSuccessStatusCode)
            {
                var carsResult =
                    await carsResponse.Content
                        .ReadFromJsonAsync<CarsResponse>();

                cars =
                    carsResult?.Cars
                    ?? new List<Car>();
            }

            using var fuelRequest =
                new HttpRequestMessage(
                    HttpMethod.Get,
                    "api/fuel-entries");

            fuelRequest.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    groupToken);

            var fuelResponse =
                await Http.SendAsync(fuelRequest);

            if (fuelResponse.IsSuccessStatusCode)
            {
                var fuelResult =
                    await fuelResponse.Content
                        .ReadFromJsonAsync<FuelEntriesResponse>();

                fuelEntries =
                    fuelResult?.FuelEntries
                    ?? new List<FuelEntry>();
            }

            // Spara resultatet gemensamt i appens minne.
            FuelData.SetData(cars, fuelEntries);
        }
        catch
        {
            // Behåll sidan fungerande även om servern inte kan nås.
        }

        isInitialLoading = false;
    }

   

    private void GoToAddFuel()
    {
        Navigation.NavigateTo("/add-fuel");
    }

    private void GoToHistory()
    {
        Navigation.NavigateTo("/history");
    }

    private void GoToCars()
    {
        Navigation.NavigateTo("/cars");
    }

    private void GoToGroup()
    {
        Navigation.NavigateTo("/group");
    }

    private void ToggleSettings()
    {
        showSettings = !showSettings;
    }

    private void GoToBackup()
    {
        showSettings = false;
        Navigation.NavigateTo("/backup");
    }

    private class CarsResponse
    {
        public bool Success { get; set; }

        public List<Car> Cars { get; set; } = new();
    }

    private class FuelEntriesResponse
    {
        public bool Success { get; set; }

        public List<FuelEntry> FuelEntries { get; set; } = new();
    }
}