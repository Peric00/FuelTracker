@page "/history"
@using FuelTracker.Models
@using FuelTracker.Services
@using System.Globalization
@inject StorageService Storage
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Historik</PageTitle>

<div class="fuel-history-page">


    <!-- Header -->
    <header class="fuel-page-header">

        <div class="fuel-page-header-icon fuel-history-header-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" />
            </svg>
        </div>

        <div>
            <div class="fuel-eyebrow">
                ÖVERSIKT
            </div>

            <h1>Historik</h1>

            <p>
                Se dina tankningar månad för månad.
            </p>
        </div>

    </header>

    <!-- Månadsväljare -->
    <section class="fuel-month-picker">

        <button class="fuel-month-arrow"
                @onclick="PreviousMonth"
                aria-label="Föregående månad">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
            </svg>
        </button>

        <div class="fuel-month-center">
            <span>MÅNAD</span>

            <strong>
                @MonthName
            </strong>
        </div>

        <button class="fuel-month-arrow"
                @onclick="NextMonth"
                aria-label="Nästa månad">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m9 18 6-6-6-6" />
            </svg>
        </button>

    </section>

    <!-- Bilfilter -->
    @if (cars.Count > 1)
    {
        <section class="fuel-history-filter">

            <div class="fuel-history-filter-label">

                <span class="fuel-history-filter-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m5 11 1.5-4h11L19 11" />
                        <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                        <circle cx="7" cy="16" r="1" />
                        <circle cx="17" cy="16" r="1" />
                    </svg>
                </span>

                <span>Visa bil</span>

            </div>

            <div class="fuel-custom-select">

                <button type="button"
                        class="fuel-history-select fuel-custom-select-button"
                        @onclick="ToggleHistoryCarDropdown">

                    <span>@SelectedHistoryCarName</span>

                    <span class="fuel-custom-select-arrow @(historyCarDropdownOpen ? "open" : "")">
                        ⌄
                    </span>

                </button>

                @if (historyCarDropdownOpen)
                {
                    <div class="fuel-custom-select-menu">

                        <button type="button"
                                class="fuel-custom-select-option @(selectedCarId == Guid.Empty ? "selected" : "")"
                                @onclick="() => SelectHistoryCar(Guid.Empty)">

                            Alla bilar

                        </button>

                        @foreach (var car in cars)
                        {
                            <button type="button"
                                    class="fuel-custom-select-option @(selectedCarId == car.Id ? "selected" : "")"
                                    @onclick="() => SelectHistoryCar(car.Id)">

                                @car.Name

                            </button>
                        }

                    </div>
                }

            </div>

        </section>
    }

    <!-- Statistik -->
    <section class="fuel-history-stats">

        <div class="fuel-history-stat fuel-history-stat-purple">

            <div class="fuel-history-stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 3h9v18H4V5a2 2 0 0 1 2-2Z" />
                    <path d="M7 6h5v5H7z" />
                    <path d="M15 8h2l3 3v6a2 2 0 0 1-4 0" />
                </svg>
            </div>

            <span>Tankningar</span>

            <strong>
                @MonthlyEntries.Count
            </strong>

            <div class="fuel-history-stat-glow"></div>

        </div>

        <div class="fuel-history-stat fuel-history-stat-cyan">

            <div class="fuel-history-stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M15.5 8.5c-.8-.7-1.8-1-3-1-1.7 0-3 .8-3 2s1 1.8 3 2.2 3 1 3 2.3-1.3 2.2-3.2 2.2c-1.2 0-2.4-.4-3.3-1.2" />
                    <path d="M12 5.5v13" />
                </svg>
            </div>

            <span>Kostnad</span>

            <strong class="fuel-history-money">
                @TotalCost.ToString("0.00")
                <small>kr</small>
            </strong>

            <div class="fuel-history-stat-glow"></div>

        </div>

        <div class="fuel-history-stat fuel-history-stat-orange">

            <div class="fuel-history-stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3s6 6.2 6 11a6 6 0 0 1-12 0c0-4.8 6-11 6-11Z" />
                </svg>
            </div>

            <span>Liter</span>

            <strong>
                @TotalLiters.ToString("0.##")
                <small>L</small>
            </strong>

            <div class="fuel-history-stat-glow"></div>

        </div>

        <div class="fuel-history-stat fuel-history-stat-lime">

            <div class="fuel-history-stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 18 9 13l4 3 7-9" />
                    <path d="M15 7h5v5" />
                </svg>
            </div>

            <span>Snittpris</span>

            <strong>
                @AveragePrice.ToString("0.00")
                <small>kr/L</small>
            </strong>

            <div class="fuel-history-stat-glow"></div>

        </div>

    </section>

    <!-- Tankningar -->
    <section class="fuel-history-list">

        <div class="fuel-history-list-title">

            <div>
                <div class="fuel-eyebrow">
                    TANKNINGAR
                </div>

                <h2>
                    @MonthName
                </h2>
            </div>

            <span class="fuel-history-count">
                @MonthlyEntries.Count
            </span>

        </div>

        @if (MonthlyEntries.Count == 0)
        {
            <div class="fuel-history-empty">

                <div class="fuel-history-empty-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 3h9v18H4V5a2 2 0 0 1 2-2Z" />
                        <path d="M7 6h5v5H7z" />
                        <path d="M15 8h2l3 3v6a2 2 0 0 1-4 0" />
                    </svg>
                </div>

                <h3>Inga tankningar</h3>

                <p>
                    Du har inga registrerade tankningar den här månaden.
                </p>

            </div>
        }
        else
        {
            @foreach (var entry in MonthlyEntries)
            {
                var car =
                    cars.FirstOrDefault(c => c.Id == entry.CarId);

                var displayCarName =
                    !string.IsNullOrWhiteSpace(entry.CarName)
                        ? entry.CarName
                        : car?.Name ?? "Okänd bil";

                <article class="fuel-history-entry">

                    <div class="fuel-history-entry-accent"></div>

                    <div class="fuel-history-entry-date">
                        <span>
                            @entry.Date.ToString(
                                "dddd",
                                SwedishCulture)
                        </span>

                        <strong>
                            @entry.Date.ToString(
                                "d MMMM",
                                SwedishCulture)
                        </strong>
                    </div>

                    <div class="fuel-history-entry-top">

                        <div class="fuel-history-car">

                            <div class="fuel-history-car-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m5 11 1.5-4h11L19 11" />
                                    <path d="M3 13a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5H3z" />
                                    <circle cx="7" cy="16" r="1" />
                                    <circle cx="17" cy="16" r="1" />
                                </svg>
                            </div>

                            <h3>
                                @displayCarName
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(entry.MemberName))
                            {
                                <span class="fuel-history-member">
                                    Tankat av @entry.MemberName
                                </span>
                            }

                        </div>

                        <div class="fuel-history-price">
                            @entry.PricePerLiter.ToString("0.00")
                            <small>kr/L</small>
                        </div>

                    </div>

                    <div class="fuel-history-entry-values">

                        <div>
                            <span>Liter</span>

                            <strong>
                                @entry.Liters.ToString("0.##")
                                <small>L</small>
                            </strong>
                        </div>

                        <div class="fuel-history-value-divider"></div>

                        <div>
                            <span>Kostnad</span>

                            <strong>
                                @entry.TotalCost.ToString("0.00")
                                <small>kr</small>
                            </strong>
                        </div>

                    </div>

                    @if (entryToDelete == entry.Id)
                    {
                        <div class="fuel-delete-confirm">

                            <strong>
                                Ta bort tankningen?
                            </strong>

                            <p>
                                Tankningen tas bort permanent och månadens statistik räknas om.
                            </p>

                            <div class="fuel-confirm-actions">

                                <button class="fuel-danger-button"
                                        @onclick="() => DeleteFuelEntry(entry)">
                                    Ja, ta bort
                                </button>

                                <button class="fuel-cancel-button"
                                        @onclick="CancelDelete">
                                    Avbryt
                                </button>

                            </div>

                        </div>
                    }
                    else
                    {
                        <button class="fuel-delete-link"
                                @onclick="() => AskToDelete(entry)">

                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 7h16" />
                                <path d="m9 7 1-3h4l1 3" />
                                <path d="M7 7l1 13h8l1-13" />
                            </svg>

                            Ta bort tankning
                        </button>
                    }

                </article>
            }
        }

    </section>

</div>

<SuccessToast @ref="deleteSuccessToast"
              Message="Tankningen är borttagen"
              Description="Tankningen har tagits bort från historiken."
              Variant="danger" />

<SuccessToast @ref="deleteErrorToast"
              Message="Kunde inte ta bort tankningen"
              Description="@deleteErrorMessage"
              Variant="danger" />

@code {

    private List<Car> cars = new();
    private List<FuelEntry> fuelEntries = new();
    private SuccessToast? deleteSuccessToast;
    private SuccessToast? deleteErrorToast;
    private string deleteErrorMessage = "";

    private string? groupToken;

    private Guid? selectedCarId;
    private Guid? entryToDelete;

    private DateTime selectedMonth =
        new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private CultureInfo SwedishCulture =>
        CultureInfo.GetCultureInfo("sv-SE");

    private bool historyCarDropdownOpen = false;

private string SelectedHistoryCarName
{
    get
    {
        if (selectedCarId == Guid.Empty)
            return "Alla bilar";

        var car = cars.FirstOrDefault(c => c.Id == selectedCarId);

        return car?.Name ?? "Alla bilar";
    }
}

private void ToggleHistoryCarDropdown()
{
    historyCarDropdownOpen = !historyCarDropdownOpen;
}

private void SelectHistoryCar(Guid carId)
{
    selectedCarId = carId;
    historyCarDropdownOpen = false;
}
        
        private string MonthName
    {
        get
        {
            var text =
                selectedMonth.ToString(
                    "MMMM yyyy",
                    SwedishCulture);

            return char.ToUpper(text[0]) + text[1..];
        }
    }

    private List<FuelEntry> MonthlyEntries =>
        fuelEntries
            .Where(entry =>
                entry.Date.Year == selectedMonth.Year &&
                entry.Date.Month == selectedMonth.Month &&
                (selectedCarId == null ||
                 entry.CarId == selectedCarId))
            .OrderByDescending(entry => entry.Date)
            .ThenByDescending(entry => entry.Id)
            .ToList();

    private decimal TotalCost =>
        MonthlyEntries.Sum(
            entry => entry.TotalCost);

    private decimal TotalLiters =>
        MonthlyEntries.Sum(
            entry => entry.Liters);

    private decimal AveragePrice =>
        TotalLiters > 0
            ? TotalCost / TotalLiters
            : 0;

    protected override async Task OnInitializedAsync()
    {
        groupToken =
            await Storage.LoadAsync<string>("groupToken");

        if (string.IsNullOrWhiteSpace(groupToken))
        {
            cars =
                await Storage.LoadAsync<List<Car>>("cars")
                ?? new List<Car>();

            fuelEntries =
                await Storage.LoadAsync<List<FuelEntry>>("fuelEntries")
                ?? new List<FuelEntry>();

            return;
        }

        try
        {
            // Hämta gruppens bilar
            using var carRequest =
                new HttpRequestMessage(
                    HttpMethod.Get,
                    "api/cars");

            carRequest.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    groupToken);

            var carResponse =
                await Http.SendAsync(carRequest);

            if (carResponse.IsSuccessStatusCode)
            {
                var carResult =
                    await carResponse.Content.ReadFromJsonAsync<CarsResponse>();

                cars =
                    carResult?.Cars
                    ?? new List<Car>();
            }
            else
            {
                cars = new List<Car>();
            }

            // Hämta gruppens tankningar
            using var fuelRequest =
                new HttpRequestMessage(
                    HttpMethod.Get,
                    "api/fuel-entries");

            fuelRequest.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    groupToken);

            var fuelResponse =
                await Http.SendAsync(fuelRequest);

            if (fuelResponse.IsSuccessStatusCode)
            {
                var fuelResult =
                    await fuelResponse.Content.ReadFromJsonAsync<FuelEntriesResponse>();

                fuelEntries =
                    fuelResult?.FuelEntries
                    ?? new List<FuelEntry>();
            }
            else
            {
                fuelEntries = new List<FuelEntry>();
            }
        }
        catch
        {
            cars = new List<Car>();
            fuelEntries = new List<FuelEntry>();
        }
    }

    private void PreviousMonth()
    {
        selectedMonth =
            selectedMonth.AddMonths(-1);

        entryToDelete = null;
    }

    private void NextMonth()
    {
        selectedMonth =
            selectedMonth.AddMonths(1);

        entryToDelete = null;
    }

    private void AskToDelete(FuelEntry entry)
    {
        entryToDelete = entry.Id;
    }

    private void CancelDelete()
    {
        entryToDelete = null;
    }

    private async Task DeleteFuelEntry(FuelEntry entry)
    {
        deleteErrorMessage = "";

        if (string.IsNullOrWhiteSpace(groupToken))
        {
            fuelEntries.RemoveAll(
                e => e.Id == entry.Id);

            await Storage.SaveAsync(
                "fuelEntries",
                fuelEntries);

            entryToDelete = null;

            if (deleteSuccessToast != null)
            {
                _ = deleteSuccessToast.ShowAsync();
            }

            return;
        }

        try
        {
            using var request =
                new HttpRequestMessage(
                    HttpMethod.Delete,
                    $"api/fuel-entries?id={entry.Id}");

            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    groupToken);

            var response =
                await Http.SendAsync(request);

            if (!response.IsSuccessStatusCode)
            {
                deleteErrorMessage =
                    "Kunde inte ta bort tankningen.";

                entryToDelete = null;

                if (deleteErrorToast != null)
                {
                    _ = deleteErrorToast.ShowAsync();
                }

                return;
            }

            fuelEntries.RemoveAll(
                e => e.Id == entry.Id);

            entryToDelete = null;

            if (deleteSuccessToast != null)
            {
                _ = deleteSuccessToast.ShowAsync();
            }
        }
        catch
        {
            deleteErrorMessage =
                "Kunde inte ansluta till servern.";

            entryToDelete = null;

            if (deleteErrorToast != null)
            {
                _ = deleteErrorToast.ShowAsync();
            }
        }
    }

    private class CarsResponse
    {
        public bool Success { get; set; }

        public List<Car> Cars { get; set; } = new();
    }

    private class FuelEntriesResponse
    {
        public bool Success { get; set; }

        public List<FuelEntry> FuelEntries { get; set; } = new();
    }
}