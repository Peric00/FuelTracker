@page "/group"
@using System.Net.Http.Json
@using FuelTracker.Services
@inject HttpClient Http
@inject StorageService Storage

<PageTitle>Grupp - FuelTracker</PageTitle>

<div class="group-page">

    <BackButton />

    <div class="group-hero">
        <div class="group-icon">👥</div>

        <h1>Din grupp</h1>

        <p>
            Dela FuelTracker med familjen. Alla i gruppen kan
            se samma bilar och tankningar.
        </p>
    </div>

    <div class="group-options">

        <button class="group-option-card group-create"
                @onclick="ShowCreateGroup">

            <div class="group-option-icon">＋</div>

            <div class="group-option-text">
                <strong>Skapa grupp</strong>
                <span>Starta en ny grupp och bjud in andra.</span>
            </div>

            <div class="group-option-arrow">›</div>
        </button>

        <button class="group-option-card group-join"
                @onclick="ShowJoinGroup">

            <div class="group-option-icon">#</div>

            <div class="group-option-text">
                <strong>Gå med i grupp</strong>
                <span>Använd en 6-siffrig gruppkod.</span>
            </div>

            <div class="group-option-arrow">›</div>
        </button>

    </div>


    @if (mode == "create")
    {
        <div class="group-form-card">

            <div class="group-form-heading">
                <h2>Skapa grupp</h2>
                <p>Ge gruppen ett namn och skriv ditt namn.</p>
            </div>

            <label>Gruppnamn</label>
            <input class="form-control"
                   placeholder="T.ex. Familjen Peric"
                   @bind="groupName" />

            <label>Ditt namn</label>
            <input class="form-control"
                   placeholder="T.ex. Emil"
                   @bind="memberName" />

            <button class="group-primary-button"
                    @onclick="CreateGroup"
                    disabled="@isLoading">
                @(isLoading ? "Skapar..." : "Skapa grupp")
            </button>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="group-error-message">
                    @errorMessage
                </p>
            }

        </div>
    }


    @if (mode == "join")
    {
        <div class="group-form-card">

            <div class="group-form-heading">
                <h2>Gå med i grupp</h2>
                <p>Skriv gruppens 6-siffriga kod och ditt namn.</p>
            </div>

            <label>Gruppkod</label>
            <input class="form-control group-code-input"
                   type="text"
                   inputmode="numeric"
                   maxlength="6"
                   placeholder="000000"
                   @bind="joinCode" />

            <label>Ditt namn</label>
            <input class="form-control"
                   placeholder="T.ex. Emil"
                   @bind="memberName" />

            <button class="group-primary-button">
                Gå med i grupp
            </button>

        </div>
    }

</div>

@code {
    private string? mode;

    private string groupName = "";
    private string memberName = "";
    private string joinCode = "";

    private bool isLoading = false;
    private string errorMessage = "";

    private void ShowCreateGroup()
    {
        mode = "create";
        errorMessage = "";
    }

    private void ShowJoinGroup()
    {
        mode = "join";
        errorMessage = "";
    }

    private async Task CreateGroup()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(groupName) ||
            string.IsNullOrWhiteSpace(memberName))
        {
            errorMessage = "Fyll i gruppnamn och ditt namn.";
            return;
        }

        isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/groups-create",
                new
                {
                    groupName = groupName.Trim(),
                    memberName = memberName.Trim()
                });

            var result =
                await response.Content.ReadFromJsonAsync<GroupResponse>();

            if (!response.IsSuccessStatusCode ||
                result == null ||
                !result.Success)
            {
                errorMessage =
                    result?.Error ?? "Kunde inte skapa gruppen.";

                return;
            }

            await Storage.SaveAsync(
                "groupToken",
                result.Token);

            mode = null;
        }
        catch
        {
            errorMessage = "Kunde inte ansluta till servern.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class GroupResponse
    {
        public bool Success { get; set; }
        public string? Error { get; set; }
        public string Token { get; set; } = "";
        public GroupInfo? Group { get; set; }
        public MemberInfo? Member { get; set; }
    }

    private class GroupInfo
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string JoinCode { get; set; } = "";
    }

    private class MemberInfo
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
    }
}