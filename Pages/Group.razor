@page "/group"
@using System.Net.Http.Json
@using FuelTracker.Services
@inject HttpClient Http
@inject StorageService Storage
@using FuelTracker.Models
@inject FuelDataService FuelData

<PageTitle>Grupp - FuelTracker</PageTitle>

<div class="group-page">
    <SuccessToast @ref="successToast"
                  Message="Gruppen är skapad!"
                  Description="Du kan nu bjuda in andra med gruppkoden." />
    
    <div class="group-hero">
        <div class="group-icon">👥</div>

        <h1>Din grupp</h1>

        <p>
            Dela FuelTracker med andra. Alla i gruppen kan
            se samma bilar och tankningar.
        </p>
    </div>


    @if (isCheckingGroup)
    {
        <div class="group-form-card">

            <div class="group-form-heading">
                <h2>Hämtar din grupp...</h2>
                <p>Kontrollerar ditt medlemskap.</p>
            </div>

        </div>
    }
    else if (currentGroup != null && currentMember != null)
    { 
        
        <div class="group-form-card">

            <div class="group-form-heading">
                <h2>@currentGroup.Name</h2>
                <p>
                    Du är med i gruppen som @currentMember.Name.
                </p>
            </div>

            <label>Gruppkod</label>

            <div class="group-code-input form-control">
                @currentGroup.JoinCode
            </div>

            <p style="color: var(--fuel-muted); margin-top: 14px;">
                Dela den 6-siffriga koden med andra
                så att de kan gå med i gruppen.
            </p>

            <div class="group-members">

                <div class="group-members-heading">
                    <strong>Gruppmedlemmar</strong>
                    <span>@members.Count medlem@(members.Count == 1 ? "" : "mar")</span>
                </div>

                @if (isLoadingMembers)
                {
                    <p class="group-members-loading">
                        Hämtar medlemmar...
                    </p>
                }
                else if (members.Count == 0)
                {
                    <p class="group-members-loading">
                        Inga medlemmar kunde hämtas.
                    </p>
                }
                else
                {
                    @foreach (var member in members)
                    {
                        <div class="group-member-row">

                            <div class="group-member-avatar">
                                @GetInitial(member.Name)
                            </div>

                            <div class="group-member-info">
                                <strong>@member.Name</strong>

                                @if (member.Id == currentMember?.Id)
                                {
                                    <span>Du</span>
                                }
                            </div>

                        </div>
                    }
                }

            </div>
            <button class="group-option-card group-leave"
                    @onclick="LeaveGroup">
                <div class="group-option-icon">←</div>

                <div class="group-option-text">
                    <strong>Lämna grupp</strong>
                    <span>Ta bort dig själv från gruppen.</span>
                </div>

                <div class="group-option-arrow">›</div>
            </button>
        </div>
    }
    else
    {
        <div class="group-options">

            <button class="group-option-card group-create"
                    @onclick="ShowCreateGroup">

                <div class="group-option-icon">＋</div>

                <div class="group-option-text">
                    <strong>Skapa grupp</strong>
                    <span>Starta en ny grupp och bjud in andra.</span>
                </div>

                <div class="group-option-arrow">›</div>

            </button>


            <button class="group-option-card group-join"
                    @onclick="ShowJoinGroup">

                <div class="group-option-icon">#</div>

                <div class="group-option-text">
                    <strong>Gå med i grupp</strong>
                    <span>Använd en 6-siffrig gruppkod.</span>
                </div>

                <div class="group-option-arrow">›</div>

            </button>

        </div>


        @if (mode == "create")
        {
            <div class="group-form-card">

                <div class="group-form-heading">
                    <h2>Skapa grupp</h2>
                    <p>Ge gruppen ett namn och skriv ditt namn.</p>
                </div>

                <label>Gruppnamn</label>

                <input class="form-control"
                       placeholder="T.ex. Bensinligan"
                       @bind="groupName" />

                <label>Ditt namn</label>

                <input class="form-control"
                       placeholder="T.ex. Emil"
                       @bind="memberName" />

                <button class="group-primary-button"
                        @onclick="CreateGroup"
                        disabled="@isLoading">

                    @(isLoading ? "Skapar..." : "Skapa grupp")

                </button>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <p class="group-error-message">
                        @errorMessage
                    </p>
                }

            </div>
        }


        @if (mode == "join")
        {
            <div class="group-form-card">

                <div class="group-form-heading">
                    <h2>Gå med i grupp</h2>
                    <p>Skriv gruppens 6-siffriga kod och ditt namn.</p>
                </div>

                <label>Gruppkod</label>

                <input class="form-control group-code-input"
                       type="text"
                       inputmode="numeric"
                       maxlength="6"
                       placeholder="000000"
                       @bind="joinCode" />

                <label>Ditt namn</label>

                <input class="form-control"
                       placeholder="T.ex. Emil"
                       @bind="memberName" />

                <button class="group-primary-button"
                        @onclick="JoinGroup"
                        disabled="@isLoading">

                    @(isLoading ? "Går med..." : "Gå med i grupp")

                </button>

            </div>
        }
    }

</div>

@if (showImportPrompt)
{
    <div class="fuel-import-overlay">
        <div class="fuel-import-modal">

            <div class="fuel-import-icon">↗</div>

            <h2>Flytta din sparade data?</h2>

            <p>
                Du har
                <strong>@localCarsToImport.Count bil(ar)</strong>
                och
                <strong>@localFuelEntriesToImport.Count tankning(ar)</strong>
                sparade på den här enheten.
            </p>

            <p>
                Vill du flytta dem till gruppen så att alla i gruppen kan se dem?
            </p>

            <button class="fuel-import-primary"
                    @onclick="ImportLocalData"
                    disabled="@isLoading">
                @(isLoading ? "Flyttar..." : "Ja, flytta till gruppen")
            </button>

            <button class="fuel-import-secondary"
                    @onclick="SkipImport"
                    disabled="@isLoading">
                Nej, börja utan dem
            </button>

        </div>
    </div>
}


@code {
    private string? mode;

    private string groupName = "";
    private string memberName = "";
    private string joinCode = "";

    private bool showImportPrompt = false;
    private List<Car> localCarsToImport = new();
    private List<FuelEntry> localFuelEntriesToImport = new();

    private bool isLoading = false;
    private string errorMessage = "";
    private SuccessToast? successToast;

    private bool isCheckingGroup = true;

    private GroupInfo? currentGroup;
    private MemberInfo? currentMember;
    private List<MemberInfo> members = new();
    private bool isLoadingMembers = false;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token =
                await Storage.LoadAsync<string>("groupToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                return;
            }

            using var request =
                new HttpRequestMessage(
                    HttpMethod.Get,
                    "api/me");

            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    token);

            var response =
                await Http.SendAsync(request);

            if (!response.IsSuccessStatusCode)
            {
                await Storage.SaveAsync<string?>(
                    "groupToken",
                    null);

                return;
            }

            var result =
                await response.Content.ReadFromJsonAsync<GroupResponse>();

            if (result != null &&
                result.Success &&
                result.Group != null &&
                result.Member != null)
            {
                currentGroup = result.Group;
                currentMember = result.Member;
                
                await LoadMembers(token);
            }
        }
        catch
        {
            errorMessage =
                "Kunde inte hämta gruppinformationen.";
        }
        finally
        {
            isCheckingGroup = false;
        }
    }

    private async Task SkipImport()
    {
        await Storage.SaveAsync(
            "cars",
            new List<Car>());

        await Storage.SaveAsync(
            "fuelEntries",
            new List<FuelEntry>());

        localCarsToImport.Clear();
        localFuelEntriesToImport.Clear();

        showImportPrompt = false;
    }

    private async Task ImportLocalData()
    {
        if (isLoading)
        {
            return;
        }

        if (currentGroup == null ||
            currentMember == null)
        {
            return;
        }

        var token =
            await Storage.LoadAsync<string>("groupToken");

        if (string.IsNullOrWhiteSpace(token))
        {
            errorMessage =
                "Kunde inte hitta gruppens token.";
            return;
        }

        isLoading = true;
        errorMessage = "";

        try
        {
            var carIdMap = new Dictionary<Guid, Guid>();

            foreach (var localCar in localCarsToImport)
            {
                using var request =
                    new HttpRequestMessage(
                        HttpMethod.Post,
                        "api/cars");

                request.Headers.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue(
                        "Bearer",
                        token);

                request.Content =
                    JsonContent.Create(new
                    {
                        name = localCar.Name,
                        registrationNumber = localCar.RegistrationNumber,
                        fuelType = localCar.FuelType
                    });

                var response =
                    await Http.SendAsync(request);

                if (!response.IsSuccessStatusCode)
                {
                    throw new Exception(
                        $"Kunde inte flytta bilen {localCar.Name}.");
                }

                var result =
                    await response.Content
                        .ReadFromJsonAsync<CarResponse>();

                if (result?.Car == null)
                {
                    throw new Exception(
                        $"Kunde inte läsa den nya bilen {localCar.Name}.");
                }

                carIdMap[localCar.Id] =
                    result.Car.Id;
            }

            foreach (var localEntry in localFuelEntriesToImport)
            {
                if (!carIdMap.TryGetValue(
                        localEntry.CarId,
                        out var newCarId))
                {
                    throw new Exception(
                        "Kunde inte hitta bilen för en tankning.");
                }

                using var request =
                    new HttpRequestMessage(
                        HttpMethod.Post,
                        "api/fuel-entries");

                request.Headers.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue(
                        "Bearer",
                        token);

                request.Content =
                    JsonContent.Create(new
                    {
                        carId = newCarId,
                        liters = localEntry.Liters,
                        totalCost = localEntry.TotalCost,
                        date = localEntry.Date.ToString("yyyy-MM-dd")
                    });

                var response =
                    await Http.SendAsync(request);

                if (!response.IsSuccessStatusCode)
                {
                    throw new Exception(
                        "Kunde inte flytta en av tankningarna.");
                }
            }

            await Storage.SaveAsync(
                "cars",
                new List<Car>());

            await Storage.SaveAsync(
                "fuelEntries",
                new List<FuelEntry>());

            localCarsToImport.Clear();
            localFuelEntriesToImport.Clear();

            showImportPrompt = false;

            if (successToast != null)
            {
                successToast.Message =
                    "Din data är flyttad!";

                successToast.Description =
                    "Dina bilar och tankningar finns nu i gruppen.";

                _ = successToast.ShowAsync();
            }
        }
        catch
        {
            errorMessage =
                "Något gick fel när din sparade data skulle flyttas.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private void ShowCreateGroup()
    {
        mode = "create";
        errorMessage = "";
    }


    private void ShowJoinGroup()
    {
        mode = "join";
        errorMessage = "";
    }
    private async Task LoadMembers(string token)
    {
        isLoadingMembers = true;

        try
        {
            using var request =
                new HttpRequestMessage(
                    HttpMethod.Get,
                    "api/group-members");

            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    token);

            var response =
                await Http.SendAsync(request);

            if (!response.IsSuccessStatusCode)
            {
                members = new List<MemberInfo>();
                return;
            }

            var result =
                await response.Content
                    .ReadFromJsonAsync<MembersResponse>();

            members =
                result?.Members
                ?? new List<MemberInfo>();
        }
        catch
        {
            members = new List<MemberInfo>();
        }
        finally
        {
            isLoadingMembers = false;
        }
    }

    private string GetInitial(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        return name.Trim()[0]
            .ToString()
            .ToUpper();
    }

    private async Task CreateGroup()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(groupName) ||
            string.IsNullOrWhiteSpace(memberName))
        {
            errorMessage =
                "Fyll i gruppnamn och ditt namn.";

            return;
        }

        isLoading = true;

        try
        {
            var response =
                await Http.PostAsJsonAsync(
                    "api/groups-create",
                    new
                    {
                        groupName = groupName.Trim(),
                        memberName = memberName.Trim()
                    });

            var result =
                await response.Content.ReadFromJsonAsync<GroupResponse>();

            if (!response.IsSuccessStatusCode ||
                result == null ||
                !result.Success)
            {
                errorMessage =
                    result?.Error ??
                    "Kunde inte skapa gruppen.";

                return;
            }

            await Storage.SaveAsync(
                "groupToken",
                result.Token);

            // Den nya gruppen ska börja med en ren cache.
            FuelData.Clear();

            currentGroup = result.Group;
            currentMember = result.Member;

            localCarsToImport =
                await Storage.LoadAsync<List<Car>>("cars")
                ?? new List<Car>();

            localFuelEntriesToImport =
                await Storage.LoadAsync<List<FuelEntry>>("fuelEntries")
                ?? new List<FuelEntry>();

            showImportPrompt =
                localCarsToImport.Count > 0 ||
                localFuelEntriesToImport.Count > 0;

            if (!string.IsNullOrWhiteSpace(result.Token))
            {
                await LoadMembers(result.Token);
            }

            mode = null;

            if (successToast != null)
            {
                _ = successToast.ShowAsync();
            }
        }
        catch
        {
            errorMessage =
                "Kunde inte ansluta till servern.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task JoinGroup()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(joinCode) ||
            joinCode.Length != 6 ||
            !joinCode.All(char.IsDigit))
        {
            errorMessage = "Gruppkoden måste vara 6 siffror.";
            return;
        }

        if (string.IsNullOrWhiteSpace(memberName))
        {
            errorMessage = "Skriv ditt namn.";
            return;
        }

        isLoading = true;

        try
        {
            var response =
                await Http.PostAsJsonAsync(
                    "api/groups-join",
                    new
                    {
                        joinCode = joinCode.Trim(),
                        memberName = memberName.Trim()
                    });

            var result =
                await response.Content.ReadFromJsonAsync<GroupResponse>();

            if (!response.IsSuccessStatusCode ||
                result == null ||
                !result.Success)
            {
                errorMessage =
                    result?.Error ??
                    "Kunde inte gå med i gruppen.";

                return;
            }

            await Storage.SaveAsync(
                "groupToken",
                result.Token);

            // Säkerställ att ingen data från en tidigare grupp
            // ligger kvar i den gemensamma cachen.
            FuelData.Clear();

            currentGroup = result.Group;
            currentMember = result.Member;

            if (!string.IsNullOrWhiteSpace(result.Token))
            {
                await LoadMembers(result.Token);
            }

            mode = null;

            if (successToast != null)
            {
                successToast.Message = "Du är med i gruppen!";
                successToast.Description =
                    "Du kan nu se gruppens bilar och tankningar.";

                _ = successToast.ShowAsync();
            }
        }
        catch
        {
            errorMessage =
                "Kunde inte ansluta till servern.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LeaveGroup()
    {
        errorMessage = "";

        try
        {
            var token =
                await Storage.LoadAsync<string>("groupToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                return;
            }

            using var request =
                new HttpRequestMessage(
                    HttpMethod.Post,
                    "api/groups-leave");

            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    token);

            var response =
                await Http.SendAsync(request);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    "Kunde inte lämna gruppen.";

                return;
            }

            await Storage.SaveAsync<string?>(
                "groupToken",
                null);

            // Töm gamla gruppens data ur appens minne.
            FuelData.Clear();

            currentGroup = null;
            currentMember = null;
            members.Clear();
            mode = null;

            if (successToast != null)
            {
                successToast.Message = "Du har lämnat gruppen!";
                successToast.Description =
                    "Du kan nu skapa eller gå med i en annan grupp.";

                _ = successToast.ShowAsync();
            }
        }
        catch
        {
            errorMessage =
                "Kunde inte ansluta till servern.";
        }
    }
    private class GroupResponse
    {
        public bool Success { get; set; }

        public string? Error { get; set; }

        public string Token { get; set; } = "";

        public GroupInfo? Group { get; set; }

        public MemberInfo? Member { get; set; }
    }


    private class GroupInfo
    {
        public string Id { get; set; } = "";

        public string Name { get; set; } = "";

        public string JoinCode { get; set; } = "";
    }


    private class MemberInfo
    {
        public string Id { get; set; } = "";

        public string Name { get; set; } = "";
    }
    private class MembersResponse
    {
        public bool Success { get; set; }

        public List<MemberInfo> Members { get; set; } = new();
    }

    private class CarResponse
    {
        public bool Success { get; set; }
        public Car? Car { get; set; }
    }
}